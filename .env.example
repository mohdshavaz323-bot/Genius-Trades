# Server Configuration
PORT=8080
NODE_ENV=production
ALLOWED_ORIGINS=https://geniustraders.ai,http://localhost:8080

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_genius_traders_ai_2026_change_in_production

# AI Engine Integration (OpenAI GPT-4o Vision)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Payment Gateway (Stripe Subscription Billing)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Database Configuration (Optional Cloud Database)
DATABASE_URL=postgresql://user:password@cloud-db.postgres.database.azure.com:5432/geniustraders
